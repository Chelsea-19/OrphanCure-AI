# OrphanCure local environment template
# Copy to .env and fill in local values. Never commit .env.

# LLM provider
GEMINI_API_KEY=
ORPHANCURE_DEFAULT_MODEL=gemini-2.5-flash-lite
ORPHANCURE_FALLBACK_MODEL=gemini-2.5-flash

# Biomedical APIs
NCBI_API_KEY=
PUBMED_EMAIL=
OPENTARGETS_API_URL=https://api.platform.opentargets.org/api/v4/graphql

# Local storage
CACHE_DIR=

# Pipeline configuration
ORPHANCURE_QUALITY_THRESHOLD=0.70
ORPHANCURE_MAX_RERUNS=2
ORPHANCURE_PUBMED_MAX_FETCH=20
ORPHANCURE_PUBMED_YEAR_START=2015
ORPHANCURE_PUBMED_TARGET_EXPANSION=true
ORPHANCURE_RESOLUTION_MIN_SCORE=0.6
ORPHANCURE_RESOLUTION_MIN_DELTA=0.15
